rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '83oYhWqa5ONqFdaJUVs26BnhEZl1' ||
        request.auth.token.email in ['msa78677@gmail.com', 'admin@diranpeak.com', 'admin@diranpeakadventure.com']
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'firstName', 'role']) &&
        data.keys().hasOnly([
          'id', 'email', 'firstName', 'lastName', 'phone', 'role', 'photoURL',
          'emergencyContact', 'passportNumber', 'bio', 'favorites', 'verified', 'permissions',
          'createdAt', 'lastLoginAt', 'updatedAt', 'passwordResetRequested', 'passwordResetAt', 'tempPassword', 'country'
        ]) &&
        data.id is string && data.id.size() <= 128 &&
        data.email is string && data.email.size() <= 150 &&
        data.firstName is string && data.firstName.size() <= 100 &&
        data.role in ['customer', 'admin', 'guide', 'manager', 'moderator', 'traveler', 'climber', 'partner_vehicle', 'partner_hotel'] &&
        (!('verified' in data) || (data.verified is bool)) &&
        (!('permissions' in data) || (data.permissions is list)) &&
        (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 100)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
        (!('country' in data) || (data.country is string && data.country.size() <= 100)) &&
        (!('emergencyContact' in data) || (data.emergencyContact is string && data.emergencyContact.size() <= 200)) &&
        (!('passportNumber' in data) || (data.passportNumber is string && data.passportNumber.size() <= 100)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 2000)) &&
        (!('tempPassword' in data) || (data.tempPassword is string && data.tempPassword.size() <= 100));
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'userId', 'bookingCode', 'tourId', 'totalPrice', 'customerEmail', 'customerName', 'status']) &&
        data.keys().hasOnly([
          'id', 'userId', 'bookingCode', 'tourId', 'tourTitle', 'tourImage',
          'startDate', 'endDate', 'duration', 'adults', 'children',
          'singleTent', 'airportTransfer', 'totalPrice', 'currency',
          'bookingDate', 'status', 'customerName', 'customerEmail',
          'customerPhone', 'specialRequests', 'createdAt', 'updatedAt',
          'isGuest', 'paymentStatus'
        ]) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.bookingCode is string && data.bookingCode.size() <= 50 &&
        data.tourId is string && data.tourId.size() <= 100 &&
        data.totalPrice is number && data.totalPrice >= 0 &&
        data.customerName is string && data.customerName.size() <= 150 &&
        data.customerEmail is string && data.customerEmail.size() <= 150 &&
        data.status in ['Confirmed', 'Pending Verification', 'Cancelled', 'Completed', 'Accepted', 'Declined'] &&
        (!('specialRequests' in data) || (data.specialRequests is string && data.specialRequests.size() <= 1000)) &&
        (!('isGuest' in data) || (data.isGuest is bool)) &&
        (!('paymentStatus' in data) || (data.paymentStatus is string && data.paymentStatus.size() <= 50));
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'message']) &&
        data.keys().hasOnly(['id', 'userId', 'name', 'email', 'phone', 'subject', 'message', 'date', 'status', 'createdAt', 'tourId', 'tourTitle', 'isGuest', 'type', 'specifics', 'comments', 'replies', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 150 &&
        data.email is string && data.email.size() <= 150 &&
        data.message is string && data.message.size() <= 2500 &&
        (!('status' in data) || (data.status in ['New', 'In Review', 'Contacted', 'Replied', 'Approved', 'Declined', 'Closed'])) &&
        (!('type' in data) || (data.type in ['contact', 'vehicle', 'hotel', 'guide_porter', 'b2b_partner'])) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
        (!('subject' in data) || (data.subject is string && data.subject.size() <= 250)) &&
        (!('tourId' in data) || (data.tourId is string && data.tourId.size() <= 100)) &&
        (!('tourTitle' in data) || (data.tourTitle is string && data.tourTitle.size() <= 200)) &&
        (!('comments' in data) || (data.comments is list)) &&
        (!('replies' in data) || (data.replies is list)) &&
        (!('isGuest' in data) || (data.isGuest is bool));
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['id', 'email']) &&
        data.keys().hasOnly(['id', 'email', 'date', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.email is string && data.email.size() <= 150;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if true;
      allow create: if isSignedIn() && (isAdmin() || (request.auth.uid == userId && isValidUser(incoming()) && incoming().role == 'customer'));
      allow update: if isSignedIn() && (isAdmin() || (request.auth.uid == userId && isValidUser(incoming()) && incoming().role == existing().role && incoming().id == existing().id));
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // 2. Bookings Collection (Allows guest bookings, admin dashboard, and voucher lookups)
    match /bookings/{bookingId} {
      allow get, list: if true;
      allow create: if isValidBooking(incoming());
      allow update: if isValidBooking(incoming()) || isAdmin();
      allow delete: if isAdmin() || isSignedIn();
    }

    // 3. Inquiries Collection (Allows guest inquiries and admin management)
    match /inquiries/{inquiryId} {
      allow get, list: if true;
      allow create: if isValidInquiry(incoming());
      allow update, delete: if isAdmin() || isSignedIn();
    }

    // 4. Newsletter Subscribers Collection
    match /subscribers/{subscriberId} {
      allow get, list: if true;
      allow create: if isValidSubscriber(incoming());
      allow update, delete: if isAdmin() || isSignedIn();
    }

    // 5. Admins list
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Activities Collection (User & Traveler Activity Log for Admin)
    match /activities/{activityId} {
      allow read, list: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || isSignedIn();
    }

    // 7. Favorites Collection
    match /favorites/{favoriteId} {
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 8. Reviews Collection (Tour reviews by travelers & admins)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 9. Partners Collection (Vehicles, Hotels, B2B applications)
    match /partners/{partnerId} {
      allow create: if true;
      allow read, list, update, delete: if isAdmin();
    }

    // 10. Broadcasts Collection (Subscriber email updates from noreply@diranpeakadverture.com)
    match /broadcasts/{broadcastId} {
      allow read, list, create, update, delete: if isAdmin();
    }

    // 11. Alert Settings Collection
    match /alertSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 12. Tour Packages & Overrides Collection
    match /tourPackages/{tourId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // 13. Site Settings & Branding
    match /siteSettings/{settingId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }
  }
}
